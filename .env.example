# Sanity (içerik paneli). Proje kimliği ve dataset gizli değildir.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# Yalnızca yerelde, içerik taşıma script'i için (Editor yetkili token). Vercel'e ekleme.
SANITY_API_WRITE_TOKEN=

# Sanity webhook imzası; Vercel'de Secret olarak ve webhook ayarında aynı değer.
SANITY_REVALIDATE_SECRET=

# Yerel seed içeriğine zorla dön (ör. çevrimdışı geliştirme): local
# CONTENT_SOURCE=local

# İletişim formu (SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=
